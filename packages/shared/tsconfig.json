{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "declaration": true,
        "outDir": "dist",
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ]
}
