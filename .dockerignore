# Dependencies (reinstalled via pnpm install)
node_modules/
**/node_modules/

# Build output (rebuilt in Docker)
**/build/
**/.svelte-kit/

# Environment secrets -- never bake into image
**/.env
**/.env.*

# Dev tools
.vscode/
.idea/
*.log

# Git
.git/
.gitignore

# Agent kanban (not needed in image)
.agentkanban/

# Resources/design files
resources/

# Never copied into an image: the explainer video project (its Git LFS files alone are hundreds of
# megabytes), the documentation and blog, the browser suites, the Public Repository overlays, the
# staging stack, and local test reports and handoff notes.
video/
docs/
blog/
tests-*/
public-repos/
docker/
reports/
handoff/

# Spell check dictionary builds (served from R2, never part of an image)
.dictionaries/

# Test files
**/*.test.ts
**/vitest.config.ts
tests/
test-results/
playwright-report/
playwright.config.ts

# Agent test data

.agenttest
