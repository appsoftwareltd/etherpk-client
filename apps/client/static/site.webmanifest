{
    "name": "EtherPK",
    "short_name": "EtherPK",
    "description": "A personal knowledge base in plain markdown: a daily journal, wikilinks and backlinks, tasks and an outliner, with end-to-end encrypted sync across your devices.",
    "id": "/",
    "start_url": "/?source=pwa",
    "scope": "/",
    "display": "standalone",
    "categories": ["productivity"],
    "launch_handler": { "client_mode": ["focus-existing", "auto"] },
    "share_target": {
        "action": "/share",
        "method": "GET",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    "shortcuts": [
        { "name": "Today's journal", "short_name": "Today", "url": "/?shortcut=today&source=pwa" },
        { "name": "Search", "url": "/?shortcut=search&source=pwa" },
        { "name": "New quick note", "short_name": "Quick note", "url": "/?shortcut=quick-note&source=pwa" }
    ],
    "note_taking": { "new_note_url": "/?shortcut=quick-note&source=pwa" },
    "related_applications": [{ "platform": "webapp", "url": "/site.webmanifest" }],
    "theme_color": "#0f0f0f",
    "background_color": "#0f0f0f",
    "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "screenshots": [
        { "src": "/screenshots/editor-wide.jpg", "sizes": "1280x724", "type": "image/jpeg", "form_factor": "wide", "label": "A page with wikilinks, beside the calendar and its backlinks" },
        { "src": "/screenshots/kanban-wide.jpg", "sizes": "1280x724", "type": "image/jpeg", "form_factor": "wide", "label": "Tasks on a Kanban board" },
        { "src": "/screenshots/phone-editor.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow", "label": "A page on a phone, with a map" },
        { "src": "/screenshots/phone-drawer.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow", "label": "The calendar in the phone drawer" }
    ]
}
