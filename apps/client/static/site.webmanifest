{
    "name": "EtherPK",
    "short_name": "EtherPK",
    "description": "A personal knowledge base in plain markdown: a daily journal, wikilinks and backlinks, tasks and an outliner, with end-to-end encrypted sync across your devices.",
    "id": "/",
    "start_url": "/",
    "display": "standalone",
    "orientation": "portrait-primary",
    "share_target": {
        "action": "/share",
        "method": "GET",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    "theme_color": "#0f0f0f",
    "background_color": "#0f0f0f",
    "icons": [
        {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ]
}
