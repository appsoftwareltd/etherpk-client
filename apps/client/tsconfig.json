{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "sourceMap": true,
        "strict": true,
        // For the compiled-in extensions, which are packages of their own: the Client's
        // package.json `imports` field does not apply to them (see the alias in vite.config.ts).
        "paths": {
            "#lib/*": ["./src/lib/*"]
        }
    },
    "include": [
        "src",
        "vite.config.ts",
        "../../extensions/agent-chat/src",
        "../../extensions/excalidraw/src",
        "../../extensions/excalidraw/build-plugins",
        "../../extensions/kanban/src",
        "../../extensions/maps/src"
    ],
    "exclude": [
        "node_modules",
        "src/service-worker"
    ]
}
