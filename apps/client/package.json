{
    "name": "@appsoftwareltd/etherpk-client",
    "version": "0.28.0",
    "license": "Elastic-2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node build-extensions.mjs && vite dev",
        "build": "node build-extensions.mjs && node scripts/vite-build.mjs && node scripts/build-server.mjs",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "svelte-kit sync && vitest run",
        "test:performance:sync": "svelte-kit sync && vitest run src/lib/sync/graph-sync.test.ts -t \"keeps a 2400-document background walk bounded\"",
        "test:watch": "svelte-kit sync && vitest",
        "test:coverage": "svelte-kit sync && vitest run --coverage"
    },
    "devDependencies": {
        "@appsoftwareltd/etherpk-extension-graph-view": "workspace:*",
        "@sveltejs/adapter-node": "^6.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/vite": "^4.2.2",
        "@types/mustache": "4.2.6",
        "@types/node": "^25.6.0",
        "@vitest/coverage-v8": "^4.1.12",
        "esbuild": "^0.28.1",
        "fast-check": "^4.9.0",
        "foliate-js": "github:readest/foliate-js#0c7a0edcda672218e958fb92b4cdf090d7ca9daa",
        "linkedom": "0.18.13",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.5",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.2",
        "vite": "^8.3.3",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "@appsoftwareltd/etherpk-extension-api": "workspace:*",
        "@appsoftwareltd/etherpk-shared": "workspace:*",
        "@appsoftwareltd/etherpk-themes": "workspace:*",
        "@cantoo/pdf-lib": "^2.11.1",
        "@codemirror/commands": "^6.10.3",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.12.3",
        "@codemirror/language-data": "^6.5.2",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.43.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/atkinson-hyperlegible": "^5.3.0",
        "@fontsource/literata": "^5.3.0",
        "@lezer/common": "^1.5.2",
        "@lezer/highlight": "^1.2.3",
        "@lezer/markdown": "^1.6.4",
        "@noble/curves": "^2.2.0",
        "@noble/hashes": "^2.2.0",
        "@sqlite.org/sqlite-wasm": "3.53.0-build1",
        "@tailwindcss/typography": "^0.5.19",
        "dockview-core": "^6.6.1",
        "dompurify": "^3.4.17",
        "fflate": "0.8.3",
        "hunspell-wasm": "0.3.0",
        "idb": "^8.0.3",
        "jose": "6.2.2",
        "katex": "^0.18.2",
        "lib0": "^0.2.117",
        "markdown-it": "15.0.3",
        "mermaid": "^11.16.1",
        "mustache": "4.2.0",
        "pdfjs-dist": "^6.3.289",
        "y-codemirror.next": "^0.3.5",
        "y-protocols": "^1.0.7",
        "yaml": "^2.9.0",
        "yjs": "^13.6.31",
        "zod": "^4.6.7"
    },
    "etherpk": {
        "builtInExtensions": [
            "@appsoftwareltd/etherpk-extension-graph-view"
        ]
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
