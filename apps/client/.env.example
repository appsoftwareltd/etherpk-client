# EtherPK Client settings.
#
# Copy this file to `.env` for `pnpm dev`, or pass the same names to the Docker image or the Node
# bundle's environment. A line that starts `# NAME=` is optional: uncomment it to use it. Nothing
# here is required: with every setting unset the Client runs local graphs and offers a Custom
# server form for connecting to a Sync Server by its address.
#
# See https://docs.etherpk.com/running-etherpk-on-your-own-computer

# --- Custom server ---------------------------------------------------------------------------

# A Sync Server address the Custom server form starts filled in with.
# PUBLIC_CUSTOM_SYNC_URL=http://localhost:5174

# --- Spell check -----------------------------------------------------------------------------

# Where dictionaries are downloaded from: the folder holding `manifest.json`. Unset uses
# https://dictionaries.etherpk.com/v1; an empty value turns dictionary downloads off.
# PUBLIC_DICTIONARY_URL=https://dictionaries.example.com/v1

# --- Maps ------------------------------------------------------------------------------------

# The MapLibre style maps are drawn with: where the tiles, label fonts and icons come from. Unset
# uses EtherPK's map host (https://maps.etherpk.com). Any MapLibre style works, for example your
# own Protomaps tiles or https://tiles.openfreemap.org/styles/positron. An empty value draws maps
# with no basemap: places and routes on a plain background.
# PUBLIC_MAP_STYLE_URL=https://maps.example.com/styles/light.json
# The style for the dark theme. Unset uses PUBLIC_MAP_STYLE_URL in both themes.
# PUBLIC_MAP_STYLE_URL_DARK=https://maps.example.com/styles/dark.json
# Searching for a place by name in a map goes through the graph's Sync Server, which decides who
# may search. Set this to a Photon server's search API to have the Client ask it directly instead,
# for everyone, with no account.
# PUBLIC_PLACE_SEARCH_URL=https://photon.example.com/api
# Where postcodes are found, for everyone: one small file per postcode district, built and
# uploaded with scripts/postcodes. Unset uses EtherPK's map host (https://maps.etherpk.com/postcodes),
# or in development the set `pnpm postcodes:build` wrote, which the dev server serves. An empty
# value turns postcode search off.
# PUBLIC_POSTCODES_URL=https://maps.example.com/postcodes

# --- Legal pages -----------------------------------------------------------------------------

# Your Terms and Privacy Policy, linked from the footer of the Client's public pages. Leave them
# unset to link none.
# PUBLIC_TERMS_URL=https://example.com/terms
# PUBLIC_PRIVACY_URL=https://example.com/privacy

# --- Network ---------------------------------------------------------------------------------

# Where the Node server listens. The Docker image sets PORT=3000.
# HOST=127.0.0.1
# PORT=3000
# The Client's own origin. Unset, it is taken from the request's Host header with HTTPS assumed,
# which is right behind a TLS proxy that passes Host on.
# ORIGIN=https://app.example.com
# In place of ORIGIN, behind a proxy that sends the original protocol and host in headers of its own.
# PROTOCOL_HEADER=X-Forwarded-Proto
# HOST_HEADER=X-Forwarded-Host
# Behind a reverse proxy or CDN: the header that carries the visitor's address, which the request
# log records. Unset, the log shows the proxy's address. The proxy must overwrite this header and
# be the only way to reach the Client, or anyone can put a false address in the log. For example,
# `X-Real-IP` behind nginx with `proxy_set_header X-Real-IP $remote_addr;`, or `CF-Connecting-IP`
# behind Cloudflare.
# ADDRESS_HEADER=X-Real-IP
# With ADDRESS_HEADER=X-Forwarded-For: the number of proxies in front of the Client.
# XFF_DEPTH=1

# --- Logging ---------------------------------------------------------------------------------

# `debug`, `info` (the default), `warn` or `error`. Logs go to stdout as JSON.
# LOG_LEVEL=info
# Also send logs to an OpenObserve ingestion endpoint, with the Authorization header value it needs.
# OPENOBSERVE_URL=
# OPENOBSERVE_AUTH=
