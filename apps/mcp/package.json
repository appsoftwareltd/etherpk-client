{
    "name": "@appsoftwareltd/etherpk-mcp",
    "version": "0.8.1",
    "license": "Elastic-2.0",
    "description": "EtherPK Headless Client: an MCP server over a synced knowledge graph, run beside the agent on the user's own machine.",
    "type": "module",
    "private": false,
    "bin": {
        "etherpk-mcp": "./bin/etherpk-mcp.js"
    },
    "files": [
        "bin",
        "dist"
    ],
    "scripts": {
        "client-tsconfig": "pnpm --dir ../client exec svelte-kit sync",
        "build": "pnpm client-tsconfig && vite build",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "pnpm client-tsconfig && vitest run",
        "test:watch": "pnpm client-tsconfig && vitest",
        "prepack": "pnpm build"
    },
    "dependencies": {
        "@codemirror/language": "^6.12.3",
        "@codemirror/language-data": "^6.5.2",
        "@huggingface/tokenizers": "0.2.0",
        "@lezer/highlight": "^1.2.3",
        "@lezer/markdown": "^1.6.4",
        "@modelcontextprotocol/sdk": "1.30.0",
        "@noble/curves": "2.2.0",
        "@noble/hashes": "2.2.0",
        "@sqlite.org/sqlite-wasm": "3.53.0-build1",
        "fake-indexeddb": "^6.2.5",
        "katex": "^0.17.0",
        "lib0": "0.2.117",
        "markdown-it": "15.0.2",
        "mermaid": "^11.16.1",
        "mustache": "4.2.0",
        "playwright-core": "1.59.1",
        "y-protocols": "1.0.7",
        "yaml": "^2.9.0",
        "yjs": "13.6.31",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@appsoftwareltd/etherpk-shared": "workspace:*",
        "@appsoftwareltd/etherpk-themes": "workspace:*",
        "@codemirror/view": "^6.43.0",
        "@types/node": "^25.6.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.8",
        "vitest": "^4.1.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://docs.etherpk.com/using-ai-agents-with-your-notes",
    "repository": {
        "type": "git",
        "url": "https://github.com/appsoftwareltd/etherpk-client",
        "directory": "apps/mcp"
    },
    "keywords": [
        "etherpk",
        "mcp",
        "model-context-protocol",
        "knowledge-graph",
        "notes",
        "agent"
    ],
    "engines": {
        "node": ">=22"
    }
}