{
    "name": "@appsoftwareltd/etherpk-desktop",
    "version": "1.0.2",
    "license": "Elastic-2.0",
    "private": true,
    "description": "EtherPK for Windows and Linux: the Client in an Electron shell, with native folder access.",
    "type": "module",
    "main": "dist/main.cjs",
    "scripts": {
        "build": "node build.mjs",
        "start": "node build.mjs && electron .",
        "check": "tsc --noEmit",
        "test": "vitest run",
        "package:linux": "node build.mjs --web && electron-builder --linux --x64 --config electron-builder.config.cjs",
        "package:windows": "node build.mjs --web && electron-builder --win --x64 --config electron-builder.config.cjs"
    },
    "devDependencies": {
        "@appsoftwareltd/etherpk-native-bridge": "workspace:*",
        "@types/node": "^25.6.0",
        "electron": "45.3.4",
        "electron-builder": "26.18.1",
        "@electron/fuses": "2.1.3",
        "esbuild": "^0.28.1",
        "fast-check": "^4.9.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.12"
    },
    "author": {
        "name": "App Software Ltd",
        "url": "https://www.appsoftware.com"
    }
}
